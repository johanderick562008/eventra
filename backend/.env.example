# Copy to .env for local (non-Docker) runs. Never commit the real .env.
ENVIRONMENT=development
LOG_LEVEL=INFO

# PostgreSQL (docker compose exposes it on localhost:5433)
DATABASE_URL=postgresql+psycopg://eventra:eventra@localhost:5433/eventra
# Used by the test suite; the database name must end in _test (it is wiped on every run)
TEST_DATABASE_URL=postgresql+psycopg://eventra:eventra@localhost:5433/eventra_test

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-secure-random-secret-of-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# Comma-separated list of allowed browser origins
FRONTEND_ORIGINS=http://localhost:5173

# Business rules
BOOKING_MAX_TICKETS_PER_BOOKING=10
BOOKING_CANCELLATION_CUTOFF_HOURS=24

# Optional features (0 disables)
BOOKING_RATE_LIMIT_PER_MINUTE=5
EVENT_STATUS_SWEEP_INTERVAL_SECONDS=300
